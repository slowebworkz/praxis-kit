{
  "compilerOptions": {
    "paths": {
      "@praxis-kit/adapter-utils": ["./lib/adapter-utils/src"],
      "@praxis-kit/adapter-utils/*": ["./lib/adapter-utils/src/*"],
      "@praxis-kit/contract": ["./lib/contract/src"],
      "@praxis-kit/contract/*": ["./lib/contract/src/*"],
      "@praxis-kit/contract-props": ["./lib/contract-props/src"],
      "@praxis-kit/contract-props/*": ["./lib/contract-props/src/*"],
      "@praxis-kit/core": ["./packages/core/src"],
      "@praxis-kit/core/*": ["./packages/core/src/*"],
      "@praxis-kit/diagnostics": ["./lib/diagnostics/src"],
      "@praxis-kit/diagnostics/*": ["./lib/diagnostics/src/*"],
      "@praxis-kit/preact": ["./adapters/preact/src/index.ts"],
      "@praxis-kit/react": ["./adapters/react/src/index.ts"],
      "@praxis-kit/react/legacy": ["./adapters/react/src/legacy/index.ts"],
      "@praxis-kit/vue": ["./adapters/vue/src/index.ts"],
