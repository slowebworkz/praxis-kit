{
  "name": "praxis-kit-diagnostics",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Optional message catalogs and resolver for Praxis Kit diagnostics. Praxis Kit itself emits diagnostic codes and context; install this to turn them into localized text.",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./contract.json": "./dist/diagnostics.contract.json",
    "./en": {
      "types": "./dist/en.d.ts",
      "import": "./dist/en.js"
    },
    "./en.json": "./dist/en.json",
    "./schema.json": "./dist/catalog.v1.schema.json",
    "./catalog.v1.schema.json": "./dist/catalog.v1.schema.json"
  },
  "bin": {
    "praxis-kit-diagnostics": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && node scripts/build-schema.mjs && tsdown && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:related": "vitest run --changed",
    "prepublishOnly": "pnpm build",
    "lint:pkg": "publint"
  },
  "devDependencies": {
    "@praxis-kit/contract": "workspace:*",
    "@praxis-kit/diagnostics": "workspace:*",
    "ajv": "^6.12.6",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slowebworkz/praxis-kit.git",
    "directory": "packages/diagnostics"
  },
  "homepage": "https://github.com/slowebworkz/praxis-kit/tree/main/packages/diagnostics#readme",
  "bugs": {
    "url": "https://github.com/slowebworkz/praxis-kit/issues"
  },
  "license": "MIT",
  "author": "K Huehn <slowebworkz@gmail.com>",
  "keywords": [
    "praxis-kit",
    "diagnostics",
    "i18n",
    "localization",
    "accessibility"
  ],
  "engines": {
    "node": ">=22"
  }
}
