    "test:pw": "playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "@praxis-kit/adapter-utils": "workspace:*",
    "@praxis-kit/compose-props": "workspace:*",
    "@praxis-kit/contract-props": "workspace:*",
    "@praxis-kit/core": "workspace:*",
    "@praxis-kit/diagnostics": "workspace:*",
    "@praxis-kit/guards": "workspace:*",
    "@praxis-kit/primitive": "workspace:*",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "catalog:",
    "@praxis-kit/adapter-testing": "workspace:*",
    "@praxis-kit/playwright-testing": "workspace:*",
    "@praxis-kit/tailwind-testing": "workspace:*",
    "@praxis-kit/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/compiler-dom": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
