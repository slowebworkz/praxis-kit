{
  "name": "@praxis-kit/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "description": "Praxis Kit adapter for Vue 3 — polymorphic components with ARIA contracts and variant composition",
  "scripts": {
    "typecheck": "tsc --noEmit",
