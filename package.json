{
  "name": "praxis-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Praxis Kit — framework-neutral component infrastructure with enforced structural contracts, ARIA validation, and polymorphic rendering.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build && pnpm typecheck",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "repo-state": "node --experimental-strip-types scripts/generate-repo-state.ts",
    "aria:regen": "node --experimental-strip-types scripts/generate-aria-support.ts",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test",
    "test:related": "pnpm -r --if-present test:related",
    "metrics:collect": "pnpm --filter @praxis-kit/metrics collect",
    "metrics:report": "pnpm --filter @praxis-kit/metrics report",
    "metrics:assert": "pnpm --filter @praxis-kit/metrics assert",
    "check": "pnpm lint:check && pnpm typecheck && pnpm test",
    "verify": "pnpm --filter ./packages/kit build && pnpm check && pnpm repo-state",
    "verify:release": "pnpm verify && pnpm --filter ./packages/kit lint:pkg && pnpm --filter ./packages/kit test:pack && pnpm --filter @praxis-kit/tree-shaking-tests test && pnpm --filter @praxis-kit/bundle-analysis test && pnpm metrics:collect && pnpm metrics:assert",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "lint:check": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "lint:staged": "git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' | xargs eslint --fix",
    "lint:pkg": "pnpm -r --if-present lint:pkg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.md' | xargs prettier --write",
    "clean": "rm -rf node_modules packages/**/node_modules packages/**/dist",
    "analyze:duplicates": "jscpd --config .jscpd.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/aria-query": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "aria-query": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "jscpd": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "publint": "catalog:",
    "ts-morph": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22"
  },
  "author": "K Huehn <slowebworkz@gmail.com>"
}
